# Copy to .env and fill in with tokens issued by the MODA sandbox consoles.
# .env is gitignored. Never commit real tokens — they previously lived in the
# source tree of this public repository and had to be rotated.
#
# Comma-separate to accept more than one token for a role, e.g. "tokenA,tokenB".

# Backend (FastAPI) — issuer, wallet and verifier roles.
# Unset means every request for that role is rejected.
MEDSSI_ISSUER_TOKEN=
MEDSSI_WALLET_TOKEN=
MEDSSI_VERIFIER_TOKEN=

# Frontend (Vite) — prefills the token fields in the demo console.
# NOTE: anything prefixed VITE_ is inlined into the browser bundle and is
# therefore public. Use throwaway sandbox tokens here, never production ones.
VITE_ISSUER_TOKEN=
VITE_WALLET_TOKEN=
VITE_VERIFIER_TOKEN=
